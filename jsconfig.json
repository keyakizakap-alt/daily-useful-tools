{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["**/*.js", "**/*.mjs", "types/**/*.d.ts"],
  "exclude": ["node_modules", "**/node_modules", "gcp-cert/app.js", "gcp-cert/data", "gcp-cert/tools"]
}
