{
  "name": "daily-useful-tools",
  "version": "1.0.0",
  "private": true,
  "description": "日常で使う単一ファイルの Web ツール集。つなぎやすみ（有給の連休プランナー）のソースとテストを含む。",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node tools/build.mjs",
    "lint": "node tools/lint.mjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "check": "npm run lint && npm test"
  },
  "engines": {
    "node": ">=20"
  }
}
