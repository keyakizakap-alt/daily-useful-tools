{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)gcp-cert' ':(exclude)mail-check'",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/gcp-cert", "destination": "/", "permanent": false },
    { "source": "/gcp-cert/:path*", "destination": "/", "permanent": false },
    { "source": "/mail-check", "destination": "/", "permanent": false },
    { "source": "/mail-check/:path*", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    },
    {
      "source": "/love-type/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
