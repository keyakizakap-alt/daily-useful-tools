# ===========================================================================
# ポチパス 環境変数サンプル  ( cp .env.example .env.local )
# ===========================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
# サーバーサイド専用。絶対にクライアントへ露出しないこと。
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Prisma が直接接続する Postgres 接続文字列
# Supabase > Project Settings > Database > Connection string (URI / pooler)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Stripe Dashboard で作成した price の ID
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_xxx

# --- LLM Provider ---
# provider: openai | mock   (mock はAPIキー不要・開発用)
LLM_PROVIDER=mock
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini

# --- メール通知 (任意 / MVPでは未実装でも可) ---
RESEND_API_KEY=
EMAIL_FROM=ポチパス <noreply@example.com>
